// Reading gramide's parse tree, which arrives as one line of s-expression.
//
// Only two things are needed from it: where each function begins and ends, and
// how many decision points sit inside. Both are answerable by balancing
// parentheses and counting node heads, so no full parse of the parse is built.

// A node head is `(name` — the character before the name is `(` and the name
// runs to the next space, `(` or `)`.
fn head_at(tree: String, i: Int) -> String = {
  var j = i + 1
  var out = ""
  var stop = false
  while j < string.len(tree) and not stop {
    let c = string.get(tree, j) ?? ""
    if c == " " or c == "(" or c == ")" then stop = true
    else { out = out + c; j = j + 1 }
  }
  out
}

// The span of the s-expression that starts at `i`, by balancing parentheses.
// Returns the index just past its closing `)`.
fn span_end(tree: String, i: Int) -> Int = {
  var depth = 0
  var j = i
  var done = false
  let n = string.len(tree)
  while j < n and not done {
    let c = string.get(tree, j) ?? ""
    if c == "(" then depth = depth + 1
    else if c == ")" then {
      depth = depth - 1
      if depth == 0 then done = true else ()
    } else ()
    j = j + 1
  }
  j
}

// Every `(name` head inside `text`, in order. Nested heads are included; the
// caller decides what to do with them.
fn heads(text: String) -> List[String] = {
  var out: List[String] = []
  var i = 0
  let n = string.len(text)
  while i < n {
    if (string.get(text, i) ?? "") == "(" then list.push(out, head_at(text, i)) else ()
    i = i + 1
  }
  out
}

fn count_of(hs: List[String], name: String) -> Int =
  list.len(list.filter(hs, (h) => h == name))

// A function's decision points, from the heads inside its own span.
//
// One per `if`, one per loop, one per `guard`, and one per `match_arm` past the
// first of its `match` — a two-armed match is one decision, not two. The count
// starts at 1, so a function with no branches has a complexity of 1.
fn complexity_of(hs: List[String]) -> Int = {
  let arms = count_of(hs, "match_arm")
  let matches = count_of(hs, "match")
  1 + count_of(hs, "if") + count_of(hs, "while") + count_of(hs, "for")
    + count_of(hs, "guard") + int.max(0, arms - matches)
}

// Each top-level `(function_declaration …)` span, in source order, so the Nth
// pairs with the Nth function gramide's `symbols` reports.
fn function_spans(tree: String) -> List[String] = {
  var out: List[String] = []
  var i = 0
  let n = string.len(tree)
  while i < n {
    if (string.get(tree, i) ?? "") == "(" and head_at(tree, i) == "function_declaration" then {
      let e = span_end(tree, i)
      list.push(out, string.slice(tree, i, e))
      i = e
    } else i = i + 1
  }
  out
}

// The complexity of every function in the tree, in source order.
fn complexities(tree: String) -> List[Int] =
  list.map(function_spans(tree), (s) => complexity_of(heads(s)))

test "a head is read up to its first delimiter" {
  assert_eq(head_at("(if condition:(x))", 0), "if")
  assert_eq(head_at("(block)", 0), "block")
  assert_eq(head_at("(a(b))", 2), "b")
}

test "a span ends at its own closing paren, not an inner one" {
  assert_eq(span_end("(a (b) (c))x", 0), 11)
  assert_eq(span_end("(a)(b)", 0), 3)
}

test "a function with no branches has complexity 1" {
  assert_eq(complexity_of(heads("(function_declaration name:(identifier) body:(identifier))")), 1)
}

test "each if is one decision" {
  assert_eq(complexity_of(heads("(function_declaration (if a) (if b))")), 3)
}

test "a two-armed match is one decision, not two" {
  assert_eq(complexity_of(heads("(function_declaration (match (match_arm a) (match_arm b)))")), 2)
}

test "nested matches each keep their first arm free" {
  assert_eq(complexity_of(heads("(function_declaration (match (match_arm (match (match_arm x) (match_arm y))) (match_arm b)))")), 3)
}

test "loops and guards count" {
  assert_eq(complexity_of(heads("(function_declaration (while a) (for b) (guard c))")), 4)
}

test "functions are found in source order and measured separately" {
  let tree = "(source_file (function_declaration name:(identifier) (if a)) (function_declaration name:(identifier) (if b) (if c)))"
  assert_eq(complexities(tree), [2, 3])
}

test "a nested function does not start a second span" {
  let tree = "(source_file (function_declaration (if a) (function_declaration (if b))))"
  assert_eq(list.len(function_spans(tree)), 1)
}
